# Copy to .env next to compose.yaml. Never commit the real file.
#
# ListingWatch has no sign-in of its own: anyone who can reach it can use it.
# Put your own authentication in front of it (see docs/deployment.md).

# Contact the push services may use about this server (a mailto: or https: URL).
VAPID_SUBJECT=mailto:listingwatch@localhost

LOG_LEVEL=info
