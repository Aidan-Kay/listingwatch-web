{
  "name": "listingwatch",
  "version": "0.0.0",
  "private": true,
  "description": "Self-hosted web app that watches eBay and Vinted searches and collects new listings into one feed",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev:server": "npm run dev -w @listingwatch/server",
    "dev:web": "npm run dev -w @listingwatch/web",
    "build": "npm run build -w @listingwatch/web",
    "start": "npm start -w @listingwatch/server",
    "test": "vitest run",
    "typecheck": "npm run typecheck --workspaces --if-present"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": ">=24"
  }
}
